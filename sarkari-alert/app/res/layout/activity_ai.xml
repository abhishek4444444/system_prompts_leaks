<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary" android:padding="12dp">
        <ImageView android:id="@+id/back" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/ic_chevron_left"
            android:padding="8dp" android:background="@drawable/bg_row_ripple"
            android:contentDescription="Back"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginLeft="4dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_ai" android:contentDescription="AI"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ai_title" android:textColor="#FFFFFF"
                android:textSize="17sp" android:textStyle="bold" android:layout_marginLeft="8dp"/>
            <TextView android:id="@+id/ai_ctx" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#9FB4C9"
                android:layout_marginLeft="10dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/ai_new" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/ai_new_chat"
            android:textColor="#FFD9C2" android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/bg_row_ripple" android:padding="6dp"/>
        <TextView android:id="@+id/ai_skills" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/ai_skills"
            android:textColor="#FFD9C2" android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/bg_row_ripple" android:padding="6dp"/>
        <TextView android:id="@+id/ai_detail" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/ai_details_action"
            android:textColor="#FFD9C2" android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/bg_row_ripple" android:padding="6dp"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/ai_setup" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:visibility="gone"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ai_setup_title" android:textSize="17sp"
            android:textStyle="bold" android:textColor="@color/text_main"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ai_setup_sub" android:textSize="13sp"
            android:textColor="@color/text_sub" android:lineSpacingExtra="3dp"
            android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/ai_key" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/ai_key_hint"
            android:textSize="13sp" android:maxLines="1" android:inputType="textUri"
            android:background="@drawable/bg_input" android:padding="12dp"
            android:layout_marginTop="14dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/ai_get_key" android:textAllCaps="false"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/ai_get_key"
                android:textSize="12sp" android:textColor="@color/accent_dark"
                android:background="@drawable/bg_button_outline"/>
            <Button android:id="@+id/ai_save" android:textAllCaps="false"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/ai_save_start"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary" android:layout_marginLeft="8dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/ai_setup_privacy" android:textSize="11sp"
            android:textColor="@color/text_sub" android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/ai_chat" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:visibility="gone">
        <ListView android:id="@+id/ai_list" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:divider="@android:color/transparent" android:dividerHeight="6dp"
            android:padding="10dp" android:scrollbars="none"
            android:cacheColorHint="@android:color/transparent"
            android:stackFromBottom="true" android:transcriptMode="alwaysScroll"/>

        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:scrollbars="none"
            android:paddingLeft="10dp" android:paddingRight="10dp">
            <LinearLayout android:id="@+id/ai_chips" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingBottom="8dp"/>
        </HorizontalScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingBottom="10dp">
            <EditText android:id="@+id/ai_input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="@string/ai_msg_hint"
                android:textSize="14sp" android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:paddingRight="58dp"/>
            <FrameLayout android:id="@+id/ai_send" android:layout_width="40dp"
                android:layout_height="40dp" android:layout_gravity="right|center_vertical"
                android:layout_marginRight="6dp" android:background="@drawable/bg_send"
                android:foreground="@drawable/bg_row_ripple" android:clickable="true"
                android:focusable="true" android:contentDescription="Send">
                <ImageView android:id="@+id/ai_send_icon" android:layout_width="18dp"
                    android:layout_height="18dp" android:layout_gravity="center"
                    android:src="@drawable/ic_send"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
