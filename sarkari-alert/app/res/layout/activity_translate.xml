<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary" android:padding="12dp">
        <ImageView android:id="@+id/back" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/ic_chevron_left"
            android:padding="8dp" android:background="@drawable/bg_row_ripple"
            android:contentDescription="Back"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/translate_title" android:textColor="#FFFFFF"
            android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/translate_sub"
            android:textColor="#9FB4C9" android:textSize="11sp"
            android:layout_marginLeft="10dp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="@string/translate_from"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_sub"/>
                    <Button android:id="@+id/t_paste" android:textAllCaps="false"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/translate_paste" android:textSize="11sp"
                        android:textColor="@color/accent_dark"
                        android:background="@drawable/bg_button_outline"
                        android:paddingLeft="12dp" android:paddingRight="12dp"
                        android:minHeight="0dp" android:paddingTop="5dp" android:paddingBottom="5dp"/>
                    <Button android:id="@+id/t_clear" android:textAllCaps="false"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/translate_clear" android:textSize="11sp"
                        android:textColor="@color/text_sub"
                        android:background="@drawable/bg_button_outline"
                        android:paddingLeft="12dp" android:paddingRight="12dp"
                        android:minHeight="0dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:layout_marginLeft="6dp"/>
                </LinearLayout>
                <EditText android:id="@+id/t_src" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="4"
                    android:gravity="top" android:hint="@string/translate_hint"
                    android:textSize="14sp" android:textColor="@color/text_main"
                    android:textColorHint="@color/text_sub"
                    android:background="@drawable/bg_input" android:padding="10dp"
                    android:layout_marginTop="8dp" android:inputType="textMultiLine|textCapSentences"/>
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:scrollbars="none"
                android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/t_mode_hi" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/translate_to_hi"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingLeft="14dp" android:paddingRight="14dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"/>
                    <TextView android:id="@+id/t_mode_en" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/translate_to_en"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_sub"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="14dp" android:paddingRight="14dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"
                        android:layout_marginLeft="8dp"/>
                    <TextView android:id="@+id/t_mode_rm" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/translate_to_rm"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_sub"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="14dp" android:paddingRight="14dp"
                        android:paddingTop="7dp" android:paddingBottom="7dp"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <Button android:id="@+id/t_go" android:textAllCaps="false"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/translate_btn" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="12dp" android:layout_marginTop="10dp"
                android:visibility="gone" android:id="@+id/t_out_box">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/t_out_label" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="@string/translate_out" android:textSize="12sp"
                        android:textStyle="bold" android:textColor="@color/text_sub"/>
                    <Button android:id="@+id/t_copy" android:textAllCaps="false"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/translate_copy" android:textSize="11sp"
                        android:textColor="@color/accent_dark"
                        android:background="@drawable/bg_button_outline"
                        android:paddingLeft="12dp" android:paddingRight="12dp"
                        android:minHeight="0dp" android:paddingTop="5dp" android:paddingBottom="5dp"/>
                    <Button android:id="@+id/t_askai" android:textAllCaps="false"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/translate_askai" android:textSize="11sp"
                        android:textColor="#FFFFFF" android:background="@drawable/bg_button_dark"
                        android:paddingLeft="12dp" android:paddingRight="12dp"
                        android:minHeight="0dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:layout_marginLeft="6dp"/>
                </LinearLayout>
                <TextView android:id="@+id/t_out" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:textColor="@color/text_main" android:lineSpacingExtra="3dp"
                    android:background="@drawable/bg_input" android:padding="10dp"
                    android:layout_marginTop="8dp" android:textIsSelectable="true"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/translate_note" android:textSize="11sp"
                android:textColor="@color/text_sub" android:layout_marginTop="10dp"
                android:paddingBottom="10dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
