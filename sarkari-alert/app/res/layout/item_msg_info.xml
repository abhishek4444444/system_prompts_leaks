<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="left" android:orientation="vertical"
        android:background="@drawable/bg_chat_ai"
        android:paddingLeft="13dp" android:paddingRight="13dp"
        android:paddingTop="9dp" android:paddingBottom="9dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ai_info_ready" android:textSize="13sp"
            android:textStyle="bold" android:textColor="@color/text_main"/>
        <Button android:id="@+id/m_view" android:textAllCaps="false"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"
            android:text="@string/ai_info_view" android:textSize="12sp"
            android:textColor="#FFFFFF" android:background="@drawable/bg_button_primary"
            android:paddingLeft="16dp" android:paddingRight="16dp"/>
    </LinearLayout>
</FrameLayout>
