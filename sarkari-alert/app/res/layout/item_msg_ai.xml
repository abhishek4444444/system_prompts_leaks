<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
    <FrameLayout android:layout_width="22dp" android:layout_height="22dp"
        android:background="@drawable/bg_ai_orb">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="✦" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textStyle="bold"/>
    </FrameLayout>
    <TextView android:id="@+id/m_text" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginLeft="10dp" android:textSize="15sp"
        android:textColor="@color/text_main" android:lineSpacingExtra="3dp"
        android:textIsSelectable="true"/>
</LinearLayout>
