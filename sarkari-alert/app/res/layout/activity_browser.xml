<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary" android:paddingLeft="8dp"
        android:paddingRight="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">

        <ImageView android:id="@+id/b_back" android:layout_width="38dp"
            android:layout_height="38dp" android:src="@drawable/ic_chevron_left"
            android:padding="8dp" android:background="@drawable/bg_row_ripple"
            android:contentDescription="Back"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginLeft="6dp" android:layout_marginRight="6dp">
            <TextView android:id="@+id/b_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textStyle="bold" android:textColor="#FFFFFF"
                android:maxLines="1" android:ellipsize="end" android:text="Loading…"/>
            <TextView android:id="@+id/b_url" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="#9FB4C9" android:maxLines="1"
                android:ellipsize="middle"/>
        </LinearLayout>

        <FrameLayout android:id="@+id/b_translate" android:layout_width="34dp"
            android:layout_height="34dp" android:background="@drawable/bg_disc_tr"
            android:foreground="@drawable/bg_row_ripple" android:clickable="true"
            android:focusable="true" android:contentDescription="Translate page">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="अ"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        </FrameLayout>

        <FrameLayout android:id="@+id/b_ai" android:layout_width="34dp"
            android:layout_height="34dp" android:layout_marginLeft="7dp"
            android:background="@drawable/bg_disc_ai"
            android:foreground="@drawable/bg_row_ripple" android:clickable="true"
            android:focusable="true" android:contentDescription="Ask AI about this page">
            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                android:layout_gravity="center" android:src="@drawable/ic_ai"/>
        </FrameLayout>

        <FrameLayout android:id="@+id/b_more" android:layout_width="34dp"
            android:layout_height="34dp" android:layout_marginLeft="7dp"
            android:background="@drawable/bg_row_ripple"
            android:foreground="@drawable/bg_row_ripple" android:clickable="true"
            android:focusable="true" android:contentDescription="More options">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="center" android:src="@drawable/ic_more"/>
        </FrameLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/b_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:max="100" android:progressTint="@color/accent"
        android:progressBackgroundTint="#E4E8EE"/>

    <LinearLayout android:id="@+id/b_rescue" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:background="#FDEEE2"
        android:paddingLeft="12dp" android:paddingRight="8dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/browser_rescue_note"
            android:textSize="12sp" android:textColor="#8A4B12" android:maxLines="2"
            android:ellipsize="end"/>
        <TextView android:id="@+id/b_rescue_retry" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/browser_rescue_retry"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_dark"
            android:paddingLeft="12dp" android:paddingRight="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <WebView android:id="@+id/b_web" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
