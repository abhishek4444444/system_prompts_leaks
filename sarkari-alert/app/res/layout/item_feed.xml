<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/feed_text" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/text_main" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/feed_del" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/feed_remove"
        android:textColor="@color/red" android:textSize="12sp"
        android:paddingLeft="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"/>
</LinearLayout>
