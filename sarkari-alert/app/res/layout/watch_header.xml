<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_header"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/watch_header_title" android:textSize="17sp"
            android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/watch_header_sub" android:textSize="12sp"
            android:textColor="#C9D6E2" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <Button android:id="@+id/watch_add" android:textAllCaps="false" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/watch_add_btn"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:background="@drawable/bg_add_button" android:layout_margin="10dp"
        android:padding="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/watch_hint" android:textSize="11sp"
        android:textColor="@color/text_sub" android:gravity="center"
        android:paddingBottom="6dp"/>
</LinearLayout>
